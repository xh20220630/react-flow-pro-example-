{
  "name": "@react-flow-pro-example/core",
  "version": "0.2.0",
  "private": true,
  "description": "Readable Pro graph features built on the host official React Flow package",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./src/styles/index.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/react-flow-pro.js"
      },
      "./style.css": "./dist/react-flow-pro.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build": "vite build && tsc --project tsconfig.build.json"
  },
  "peerDependencies": {
    "@xyflow/react": "12.12.0",
    "react": ">=19.2.5 <20",
    "react-dom": ">=19.2.5 <20"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-timer": "3.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-timer": "3.0.1",
    "elkjs": "0.12.0",
    "leva": "0.10.1",
    "libavoid-js": "0.4.1",
    "lucide-react": "1.59.0",
    "perfect-cursors": "1.0.5",
    "perfect-freehand": "1.2.3",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zustand": "4.5.7"
  }
}
