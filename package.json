{
  "name": "react-flow-pro-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "dev": "node src/server/index.ts --dev --hostname 172.16.0.108 --port 3000",
    "build": "pnpm typecheck && next build",
    "start": "node src/server/index.ts --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter @react-flow-pro-example/core typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "pro:build": "pnpm --filter @react-flow-pro-example/core build",
    "pro:pack": "pnpm pro:build && pnpm --filter @react-flow-pro-example/core pack --pack-destination artifacts",
    "test:collaboration": "pnpm build && playwright test"
  },
  "dependencies": {
    "@react-flow-pro-example/core": "workspace:*",
    "@xyflow/react": "12.12.0",
    "@y/websocket-server": "0.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
